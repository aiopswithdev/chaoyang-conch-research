cat > .gitignore << 'EOF'
# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/

# Virtual environments
conch_env/
venv/
env/

# Model weights and checkpoints (too large for GitHub)
*.pt
*.bin
*.pth
*.ckpt
checkpoints/

# Dataset and features (too large for GitHub)
*.pt
features/
data/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Logs
*.log
EOF
